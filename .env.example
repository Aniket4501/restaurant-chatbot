# Copy to .env.local and fill in. Never commit .env.local.
# Admin is disabled (503) until both values are set to real values (DECISIONS D-16).
ADMIN_PASSWORD=change-me-to-12-or-more-chars
ADMIN_SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32

# Optional overrides (defaults shown).
# DATABASE_PATH=data/app.db
# LLM_PROVIDER=ollama
# EMBED_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# CHAT_MODEL=qwen3.5:9b
# EMBED_MODEL=qwen3-embedding:0.6b
