{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "faq",
        "menu",
        "recommend",
        "booking",
        "manage_booking",
        "off_topic",
        "smalltalk",
        "unclear"
      ]
    },
    "booking": {
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": [
            "string",
            "null"
          ]
        },
        "time": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeWindow": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "lunch",
                "dinner"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "partySize": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            {
              "type": "null"
            }
          ]
        },
        "ambiguity": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "branch",
                    "date",
                    "time",
                    "partySize"
                  ]
                },
                "candidates": {
                  "minItems": 2,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "field",
                "candidates"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "branch",
        "date",
        "time",
        "timeWindow",
        "partySize",
        "ambiguity"
      ],
      "additionalProperties": false
    },
    "prefs": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "diet": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "vegetarian",
                  "vegan",
                  "gluten-free",
                  "jain"
                ]
              }
            },
            "avoid": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "dairy",
                  "nuts",
                  "egg"
                ]
              }
            },
            "maxPrice": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                {
                  "type": "null"
                }
              ]
            },
            "course": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "small-plates",
                    "tandoor",
                    "mains",
                    "breads-rice",
                    "desserts",
                    "drinks"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "mild": {
              "type": "boolean"
            },
            "allergy": {
              "type": "boolean"
            },
            "relation": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "cheaper",
                    "another"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "diet",
            "avoid",
            "maxPrice",
            "course",
            "mild",
            "allergy",
            "relation"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "answer": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 600
        },
        {
          "type": "null"
        }
      ]
    },
    "citedFactIds": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answerable": {
      "type": "boolean"
    }
  },
  "required": [
    "intent",
    "booking",
    "prefs",
    "answer",
    "citedFactIds",
    "answerable"
  ],
  "additionalProperties": false
}
